rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // Global Safety Net
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Primitives & Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      // Bootstrapped admin check + database check
      return isSignedIn() && (
        request.auth.token.email == 'mostafamadadi.1382@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validations
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'operator'] &&
             data.createdAt == request.time;
    }

    function isValidCamera(data) {
      return data.keys().hasAll(['name', 'location', 'status', 'videoUrl']) &&
             data.keys().size() >= 4 &&
             data.name is string && data.name.size() <= 100 &&
             data.location is string && data.location.size() <= 100 &&
             data.status in ['active', 'inactive'] &&
             data.videoUrl is string && data.videoUrl.size() <= 512;
    }

    function isValidTrafficLog(data) {
      return data.keys().hasAll(['cameraId', 'timestamp', 'vehicleCounts', 'density', 'congestionLevel']) &&
             data.cameraId is string && exists(/databases/$(database)/documents/cameras/$(data.cameraId)) &&
             data.timestamp == request.time &&
             data.vehicleCounts is map &&
             data.vehicleCounts.car is int && data.vehicleCounts.car >= 0 &&
             data.density is number && data.density >= 0 && data.density <= 100 &&
             data.congestionLevel in ['low', 'medium', 'high'];
    }

    function isValidSignalLog(data) {
      return data.keys().hasAll(['cameraId', 'timestamp', 'state', 'duration', 'mode']) &&
             data.cameraId is string && exists(/databases/$(database)/documents/cameras/$(data.cameraId)) &&
             data.timestamp == request.time &&
             data.state in ['red', 'yellow', 'green'] &&
             data.duration is int && data.duration >= 0 &&
             data.mode in ['auto', 'manual'];
    }

    // -------------------------------------------------------------------------
    // Rule Definitions
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['email', 'createdAt']); // Prevent role hijacking
      allow delete: if isAdmin();
    }

    match /cameras/{cameraId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidCamera(incoming());
      allow update: if isAdmin() && isValidCamera(incoming());
      allow delete: if isAdmin();
    }

    match /traffic_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTrafficLog(incoming());
      // Append-only: no update or delete
    }

    match /signal_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSignalLog(incoming());
      // Append-only: no update or delete
    }
  }
}
